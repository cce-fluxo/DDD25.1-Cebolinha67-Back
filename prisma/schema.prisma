generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                  Int                  @id @default(autoincrement())
  no_usuario          String
  email_usuario       String               @unique
  cpf                 String               @unique
  nu_celular          String               @unique
  genero              Genero
  data_nascimento     DateTime
  token_esqueci_senha String?
  senha_usuario       String
  reset_token_expiry  DateTime?
  dentista            Dentista?
  imagem_usuario      ImagemUsuario?
  notificacao_usuario NotificacaoUsuario[]
  paciente            Paciente?
}

model Dentista {
  id             Int        @id @default(autoincrement())
  formacao       String
  instituto      String
  datainicio     DateTime
  datatermino    DateTime
  especializacao String
  id_usuario     Int        @unique
  consultas      Consulta[]
  usuario        Usuario    @relation(fields: [id_usuario], references: [id])
  endereco       Endereco?
  postagem       Postagem[]
}

model Paciente {
  id                Int                @id @default(autoincrement())
  rg                String             @unique
  id_usuario        Int                @unique
  consultas         Consulta[]
  convenios         Convenio[]
  usuario           Usuario            @relation(fields: [id_usuario], references: [id])
  postagem_paciente PostagemPaciente[]
}

model Notificacao {
  id                  Int                 @id @default(autoincrement())
  ds_mensagem         String
  lido                Boolean
  titulo              String
  simbolo             String
  notificacao_usuario NotificacaoUsuario?
}

model NotificacaoUsuario {
  id             Int         @id @default(autoincrement())
  id_notificacao Int         @unique
  id_usuario     Int
  id_consulta    Int?
  consulta       Consulta?   @relation(fields: [id_consulta], references: [id])
  notificacao    Notificacao @relation(fields: [id_notificacao], references: [id])
  usuario        Usuario     @relation(fields: [id_usuario], references: [id])

  @@unique([id_usuario, id_notificacao])
}

model Imagem {
  id              Int              @id @default(autoincrement())
  url             String           @unique
  nome            String
  imagem_postagem ImagemPostagem[]
  imagem_usuario  ImagemUsuario[]
}

model ImagemUsuario {
  id         Int     @id @default(autoincrement())
  id_imagem  Int
  id_usuario Int     @unique
  imagem     Imagem  @relation(fields: [id_imagem], references: [id])
  usuario    Usuario @relation(fields: [id_usuario], references: [id])

  @@unique([id_imagem, id_usuario])
}

model ImagemPostagem {
  id          Int      @id @default(autoincrement())
  id_imagem   Int
  id_postagem Int
  imagem      Imagem   @relation(fields: [id_imagem], references: [id])
  postagem    Postagem @relation(fields: [id_postagem], references: [id])

  @@unique([id_imagem, id_postagem])
}

model Endereco {
  id                    Int       @id @default(autoincrement())
  data_criacao_endereco DateTime  @default(now())
  logradouro            String
  cidade                String
  estado                String
  bairro                String
  complemento           String
  cep                   String
  id_dentista           Int       @unique
  consultas             Consulta[]
  dentista              Dentista  @relation(fields: [id_dentista], references: [id])
}

model Consulta {
  id                  Int                  @id @default(autoincrement())
  id_paciente         Int
  id_dentista         Int                
  id_convenio         Int?                 
  id_endereco         Int                  
  convenio            Convenio?            @relation(fields: [id_convenio], references: [id])
  dentista            Dentista             @relation(fields: [id_dentista], references: [id])
  endereco            Endereco             @relation(fields: [id_endereco], references: [id])
  paciente            Paciente             @relation(fields: [id_paciente], references: [id])
  detalhe_da_consulta DetalheDaConsulta?
  documentos          Documento[]
  notificacao_usuario NotificacaoUsuario[]
}

model DetalheDaConsulta {
  id             Int           @id @default(autoincrement())
  DH             DateTime
  valor          Int
  tipo_pagamento TipoPagamento
  status         String
  tipo_consulta  String
  motivo         String
  id_consulta    Int           @unique
  consulta       Consulta      @relation(fields: [id_consulta], references: [id], onDelete: Cascade)
}

model Postagem {
  id                Int                @id @default(autoincrement())
  titulo            String             @db.VarChar(150)
  mensagem          String
  id_dentista       Int
  data_criacao      DateTime           @default(now())
  tipo              TipoPostagem
  imagem_postagem   ImagemPostagem[]
  dentista          Dentista           @relation(fields: [id_dentista], references: [id])
  postagem_paciente PostagemPaciente[]

  @@index([tipo])
}

model PostagemPaciente {
  id_postagem Int
  id_paciente Int
  paciente    Paciente @relation(fields: [id_paciente], references: [id])
  postagem    Postagem @relation(fields: [id_postagem], references: [id])

  @@id([id_paciente, id_postagem])
}

model Convenio {
  id                 Int       @id @default(autoincrement())
  no_operadora       String
  nu_carteirinha     String
  dt_val_carteirinha DateTime
  id_paciente        Int
  consultas          Consulta[]
  paciente           Paciente  @relation(fields: [id_paciente], references: [id])
}

model Documento {
  id          Int      @id @default(autoincrement())
  nome_doc    String
  tipo_doc    String
  extensao    String
  tamanho_doc Float
  id_consulta Int
  consulta    Consulta @relation(fields: [id_consulta], references: [id])
}

enum Genero {
  Masculino
  Feminino
  Outros
  NaoInformado
}

enum TipoPagamento {
  particular
  convenio
}

enum TipoPostagem {
  geral
  individual
}
